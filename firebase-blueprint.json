{
  "entities": {
    "Station": {
      "title": "Station",
      "description": "Real-time Hawassa transit & fuel station state with per-category queue lanes",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the station (e.g. benzene_madya)"
        },
        "nameEn": {
          "type": "string",
          "description": "English name of the station"
        },
        "nameAm": {
          "type": "string",
          "description": "Amharic name of the station"
        },
        "neighborhoodEn": {
          "type": "string",
          "description": "English neighborhood or corridor"
        },
        "neighborhoodAm": {
          "type": "string",
          "description": "Amharic neighborhood or corridor"
        },
        "distanceKm": {
          "type": "number",
          "description": "Distance from city center in kilometers"
        },
        "activePermittedCategory": {
          "type": "string",
          "description": "Currently permitted vehicle category announced by station coordinator"
        },
        "benzeneStatus": {
          "type": "string",
          "description": "Benzene availability: AVAILABLE, LOW_STOCK, OUT_OF_STOCK"
        },
        "dieselStatus": {
          "type": "string",
          "description": "Diesel availability: AVAILABLE, LOW_STOCK, OUT_OF_STOCK"
        },
        "congestionLevel": {
          "type": "string",
          "description": "Station congestion level: LOW, MODERATE, HEAVY"
        },
        "isOpen": {
          "type": "boolean",
          "description": "Whether the station is currently open"
        },
        "lanes": {
          "type": "object",
          "description": "Map of vehicle category codes to lane metrics (currentlyServing, lastAssigned, avgDurationSeconds, isActive)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "id",
        "nameEn",
        "nameAm",
        "activePermittedCategory",
        "benzeneStatus",
        "dieselStatus",
        "lanes"
      ]
    },
    "QueueTicket": {
      "title": "QueueTicket",
      "description": "Active or historical queue ticket created by a vehicle driver",
      "type": "object",
      "properties": {
        "ticketId": {
          "type": "string",
          "description": "Unique identifier of the ticket"
        },
        "stationId": {
          "type": "string",
          "description": "Reference to the target station"
        },
        "stationNameEn": {
          "type": "string",
          "description": "Station English display name"
        },
        "stationNameAm": {
          "type": "string",
          "description": "Station Amharic display name"
        },
        "vehicleCategory": {
          "type": "string",
          "description": "Vehicle category: BAJAJ, TAXI_MINIBUS, PUBLIC_BUS, CAR, MOTORCYCLE, TRUCK_HEAVY"
        },
        "driverName": {
          "type": "string",
          "description": "Driver full name"
        },
        "phoneNumber": {
          "type": "string",
          "description": "Driver contact phone number"
        },
        "licensePlate": {
          "type": "string",
          "description": "Official vehicle license plate"
        },
        "ticketNumber": {
          "type": "integer",
          "description": "Sequential queue ticket number assigned atomically"
        },
        "status": {
          "type": "string",
          "description": "Ticket status: WAITING, CALLED, SERVING, COMPLETED, SKIPPED, CANCELLED"
        },
        "calledPumpNumber": {
          "type": "integer",
          "description": "Assigned fuel pump bay number when called"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when ticket was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last status change"
        }
      },
      "required": [
        "ticketId",
        "stationId",
        "vehicleCategory",
        "driverName",
        "phoneNumber",
        "licensePlate",
        "ticketNumber",
        "status"
      ]
    },
    "AiLog": {
      "title": "AiLog",
      "description": "Log of Gemini AI Hawassa transit recommendations and queries",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique log entry id"
        },
        "prompt": {
          "type": "string",
          "description": "Driver or coordinator transit inquiry"
        },
        "response": {
          "type": "string",
          "description": "Gemini 3.8 Flash AI recommendation"
        },
        "language": {
          "type": "string",
          "description": "Language used: AMHARIC or ENGLISH"
        },
        "userId": {
          "type": "string",
          "description": "User id of requester if authenticated"
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp of AI analysis"
        }
      },
      "required": ["id", "prompt", "response", "language", "timestamp"]
    }
  },
  "firestore": {
    "/stations/{stationId}": {
      "schema": { "$ref": "#/entities/Station" },
      "description": "Real-time Hawassa station announcements, lane counters, and fuel availability"
    },
    "/tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/QueueTicket" },
      "description": "Live driver queue tickets synced between Driver apps and Coordinator dashboard"
    },
    "/ai_logs/{logId}": {
      "schema": { "$ref": "#/entities/AiLog" },
      "description": "Gemini AI transit optimization queries and insights"
    }
  }
}
