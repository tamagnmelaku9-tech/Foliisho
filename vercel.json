{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/download/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/web-admin.html"
    },
    {
      "source": "/driver",
      "destination": "/driver-app.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
