{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "app/**",
      "backend/**",
      "gradle/**",
      "build/**",
      ".build-outputs/**",
      "*.gradle.kts",
      "*.properties",
      "*.base64"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/web-admin.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
