rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidStation(data) {
      return data.keys().hasAll(['id', 'nameEn', 'nameAm', 'currentCategory', 'currentlyServing', 'benzeneAvailable', 'dieselAvailable'])
        && data.id is string
        && data.nameEn is string
        && data.nameAm is string
        && data.currentCategory is string
        && data.currentlyServing is int
        && data.benzeneAvailable is bool
        && data.dieselAvailable is bool;
    }

    function isValidQueueTicket(data) {
      return data.keys().hasAll(['ticketId', 'stationId', 'vehicleCategory', 'driverName', 'phoneNumber', 'licensePlate', 'ticketNumber', 'status'])
        && data.ticketId is string
        && data.stationId is string
        && data.vehicleCategory is string
        && data.driverName is string
        && data.phoneNumber is string
        && data.licensePlate is string
        && data.ticketNumber is int
        && data.status is string;
    }

    function isValidAiLog(data) {
      return data.keys().hasAll(['id', 'prompt', 'response', 'language', 'timestamp'])
        && data.id is string
        && data.prompt is string
        && data.response is string
        && data.language is string
        && data.timestamp is string;
    }

    // Public real-time transit & fuel station radar
    match /stations/{stationId} {
      allow read: if true;
      allow write: if request.auth != null && isValidStation(request.resource.data);
    }

    // Driver queue tickets
    match /tickets/{ticketId} {
      allow read: if true;
      allow create: if isValidQueueTicket(request.resource.data);
      allow update: if isValidQueueTicket(request.resource.data);
      allow delete: if request.auth != null;
    }

    // AI transit optimization query history
    match /ai_logs/{logId} {
      allow read, write: if request.auth != null && isValidAiLog(request.resource.data);
    }
  }
}
